    # --------------------------------------------------------------------------
    # PESTAÑA 1: VENTILADORES Y RENDIMIENTO
    # --------------------------------------------------------------------------
    def create_fans_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(12)

        # 1. Cuadrícula HUD
        metrics_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        metrics_box.set_homogeneous(True)

        c1 = self.create_metric_card("🌡️ CPU TEMP", "lbl_cpu_temp", "-- °C", "Intel Core i7-8750H", "#38bdf8")
        c2 = self.create_metric_card("🎮 GPU TEMP", "lbl_gpu_temp", "-- °C", "Tarjeta Gráfica", "#34d399")
        c3 = self.create_metric_card("🌀 VENTILADOR CPU", "lbl_fan1_rpm", "-- RPM", "Canal Automático", "#a78bfa")
        c4 = self.create_metric_card("🌀 VENTILADOR GPU", "lbl_fan2_rpm", "-- RPM", "Canal Automático", "#f472b6")

        metrics_box.pack_start(c1, True, True, 0)
        metrics_box.pack_start(c2, True, True, 0)
        metrics_box.pack_start(c3, True, True, 0)
        metrics_box.pack_start(c4, True, True, 0)
        box.pack_start(metrics_box, False, False, 0)

        # Frecuencia
        freq_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_freq_desc = Gtk.Label()
        lbl_freq_desc.set_markup("<span foreground='#9ca3af' font='11'>⚡ Frecuencia en tiempo real:</span>")
        self.lbl_cpu_freq = Gtk.Label()
        self.lbl_cpu_freq.set_markup("<span foreground='#ffffff' weight='bold' font='11'>-- MHz</span>")
        freq_box.pack_start(lbl_freq_desc, False, False, 0)
        freq_box.pack_start(self.lbl_cpu_freq, False, False, 0)
        box.pack_start(freq_box, False, False, 0)

        # 2. Perfiles ASUS
        profiles_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        profiles_card.get_style_context().add_class("card")

        p_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        p_title = Gtk.Label()
        p_title.set_markup("<span foreground='#ffffff' weight='bold' font='12'>Perfiles de Enfriamiento ASUS (Fn + F5)</span>")
        self.lbl_current_p = Gtk.Label()
        p_header.pack_start(p_title, False, False, 0)
        p_header.pack_end(self.lbl_current_p, False, False, 0)
        profiles_card.pack_start(p_header, False, False, 0)

        btns_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btns_box.set_homogeneous(True)

        self.btn_silent = Gtk.Button()
        self.btn_silent.get_style_context().add_class("btn-profile")
        lbl_s = Gtk.Label()
        lbl_s.set_markup("<span font='13'>🍃 <b>SILENCIOSO</b></span>\n<span font='10' foreground='#9ca3af'>Para trabajar, navegar y estudiar.\nCurva suave y mínimo ruido.</span>")
        self.btn_silent.add(lbl_s)
        self.btn_silent.connect("clicked", lambda b: self.set_profile(2))
        btns_box.pack_start(self.btn_silent, True, True, 0)

        self.btn_balanced = Gtk.Button()
        self.btn_balanced.get_style_context().add_class("btn-profile")
        lbl_b = Gtk.Label()
        lbl_b.set_markup("<span font='13'>⚖️ <b>EQUILIBRADO</b></span>\n<span font='10' foreground='#9ca3af'>Modo estándar de fábrica.\nRespuesta térmica normal.</span>")
        self.btn_balanced.add(lbl_b)
        self.btn_balanced.connect("clicked", lambda b: self.set_profile(0))
        btns_box.pack_start(self.btn_balanced, True, True, 0)

        self.btn_turbo = Gtk.Button()
        self.btn_turbo.get_style_context().add_class("btn-profile")
        lbl_t = Gtk.Label()
        lbl_t.set_markup("<span font='13'>🔥 <b>OVERBOOST</b></span>\n<span font='10' foreground='#9ca3af'>Para juegos pesados y renders.\nMáxima velocidad de ventilación.</span>")
        self.btn_turbo.add(lbl_t)
        self.btn_turbo.connect("clicked", lambda b: self.set_profile(1))
        btns_box.pack_start(self.btn_turbo, True, True, 0)

        profiles_card.pack_start(btns_box, False, False, 0)
        box.pack_start(profiles_card, False, False, 0)

        # 3. Intel Turbo Boost
        turbo_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=15)
        turbo_card.get_style_context().add_class("card")

        turbo_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        turbo_title = Gtk.Label()
        turbo_title.set_markup("<span foreground='#ffffff' weight='bold' font='12'>🚀 Intel Turbo Boost (Picos Térmicos a 4.1 GHz)</span>")
        turbo_title.set_halign(Gtk.Align.START)
        
        self.turbo_desc = Gtk.Label()
        self.turbo_desc.set_halign(Gtk.Align.START)
        turbo_info.pack_start(turbo_title, False, False, 0)
        turbo_info.pack_start(self.turbo_desc, False, False, 0)
        turbo_card.pack_start(turbo_info, True, True, 0)

        self.turbo_switch = Gtk.Switch()
        self.turbo_switch.set_valign(Gtk.Align.CENTER)
        self.turbo_switch.connect("state-set", self.on_turbo_switched)
        turbo_card.pack_end(self.turbo_switch, False, False, 0)

        box.pack_start(turbo_card, False, False, 0)
        return box

    def create_metric_card(self, title, attr_name, default_val, sub_text, color):
        c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        c.get_style_context().add_class("metric-card")

        t = Gtk.Label()
        t.set_markup(f"<span foreground='#9ca3af' font='10' weight='bold'>{title}</span>")
        t.set_halign(Gtk.Align.START)

        val = Gtk.Label()
        val.set_markup(f"<span foreground='{color}' font='20' weight='heavy'>{default_val}</span>")
        val.set_halign(Gtk.Align.START)
        setattr(self, attr_name, val)

        sub = Gtk.Label()
        sub.set_markup(f"<span foreground='#6b7280' font='9'>{sub_text}</span>")
        sub.set_halign(Gtk.Align.START)

        c.pack_start(t, False, False, 0)
        c.pack_start(val, False, False, 0)
        c.pack_start(sub, False, False, 0)
        return c

    # --------------------------------------------------------------------------
    # PESTAÑA 2: CONTROL DE TECLADO
    # --------------------------------------------------------------------------
    def create_keyboard_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(12)

        k_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        k_card.get_style_context().add_class("card")

        k_title = Gtk.Label()
        k_title.set_markup("<span foreground='#ffffff' weight='bold' font='13'>⌨️ Teclado Integrado del Portátil (ASUS N-KEY)</span>")
        k_title.set_halign(Gtk.Align.START)
        k_card.pack_start(k_title, False, False, 0)

        self.k_status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=15)
        self.lbl_k_state = Gtk.Label()
        self.lbl_k_state.set_halign(Gtk.Align.START)
        self.k_status_box.pack_start(self.lbl_k_state, True, True, 0)

        self.btn_k_action = Gtk.Button()
        self.btn_k_action.connect("clicked", self.on_toggle_keyboard)
        self.k_status_box.pack_end(self.btn_k_action, False, False, 0)
        k_card.pack_start(self.k_status_box, False, False, 0)

        k_note = Gtk.Label()
        k_note.set_markup(
            "<span foreground='#9ca3af' font='10'>"
            "• Al estar <b>DESACTIVADO</b>, las teclas internas no responden y evitan caracteres cruzados (1->7, q->m, a->j).\n"
            "• El Touchpad y los botones externos siguen funcionando con total normalidad."
            "</span>"
        )
        k_note.set_halign(Gtk.Align.START)
        k_card.pack_start(k_note, False, False, 0)

        box.pack_start(k_card, False, False, 0)

        # Teclado Externo / Falchion
        ext_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        ext_card.get_style_context().add_class("card")

        ext_title = Gtk.Label()
        ext_title.set_markup("<span foreground='#ffffff' weight='bold' font='13'>🔌 Teclado Externo ASUS ROG FALCHION</span>")
        ext_title.set_halign(Gtk.Align.START)
        ext_card.pack_start(ext_title, False, False, 0)

        self.lbl_ext_info = Gtk.Label()
        self.lbl_ext_info.set_halign(Gtk.Align.START)
        ext_card.pack_start(self.lbl_ext_info, False, False, 0)

        self.lbl_daemon_info = Gtk.Label()
        self.lbl_daemon_info.set_halign(Gtk.Align.START)
        ext_card.pack_start(self.lbl_daemon_info, False, False, 0)

        box.pack_start(ext_card, False, False, 0)
        return box

    # --------------------------------------------------------------------------
    # PESTAÑA: ILUMINACIÓN AURA RGB (7 ZONAS, BARRA Y PANTALLA TRASERA)
    # --------------------------------------------------------------------------
    def create_lighting_tab(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(12)
        scrolled.add(box)

        # 1. Tarjeta de Estado y Modo Stealth
        hdr_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=15)
        hdr_card.get_style_context().add_class("card")

        info_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        t_lbl = Gtk.Label()
        t_lbl.set_markup("<span foreground='#ffffff' weight='bold' font='12'>🌈 Iluminación ASUS Aura Sync (Teclado, Barra y Pantalla Trasera)</span>")
        t_lbl.set_halign(Gtk.Align.START)
        info_vbox.pack_start(t_lbl, False, False, 0)

        self.lbl_aura_hw = Gtk.Label()
        self.lbl_aura_hw.set_halign(Gtk.Align.START)
        if self.aura_ctrl and self.aura_ctrl.dev_path:
            self.lbl_aura_hw.set_markup(f"<span foreground='#34d399' font='10'>● <b>Controlador Conectado:</b> {self.aura_ctrl.dev_path} (ASUS N-KEY 0b05:1866)</span>")
        else:
            self.lbl_aura_hw.set_markup("<span foreground='#ef4444' font='10'>● Controlador Aura N-KEY no detectado.</span>")
        info_vbox.pack_start(self.lbl_aura_hw, False, False, 0)

        sub_desc = Gtk.Label()
        sub_desc.set_markup("<span foreground='#9ca3af' font='9'>Controla las 4 zonas del teclado, la barra de luz frontal y el logotipo ROG de la tapa de la pantalla.</span>")
        sub_desc.set_halign(Gtk.Align.START)
        info_vbox.pack_start(sub_desc, False, False, 0)

        hdr_card.pack_start(info_vbox, True, True, 0)

        # Switch de Modo Stealth / Apagar
        stealth_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        stealth_lbl = Gtk.Label()
        stealth_lbl.set_markup("<span foreground='#fca5a5' font='10' weight='bold'>Modo Stealth (Apagar)</span>")
        self.switch_stealth = Gtk.Switch()
        self.switch_stealth.set_valign(Gtk.Align.CENTER)
        is_off = self.aura_ctrl.state.get("is_off", False) if self.aura_ctrl else False
        self.switch_stealth.set_active(is_off)
        self.switch_stealth.connect("state-set", self.on_stealth_switched)
        stealth_box.pack_start(stealth_lbl, False, False, 0)
        stealth_box.pack_start(self.switch_stealth, False, False, 0)
        hdr_card.pack_end(stealth_box, False, False, 0)

        box.pack_start(hdr_card, False, False, 0)

        # 2. Tarjeta de Brillo Maestro
        b_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        b_card.get_style_context().add_class("card")

        b_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        b_title = Gtk.Label()
        b_title.set_markup("<span foreground='#ffffff' weight='bold' font='11'>💡 Intensidad de Brillo Maestro</span>")
        b_hdr.pack_start(b_title, False, False, 0)

        self.lbl_brightness_val = Gtk.Label()
        cur_b = self.aura_ctrl.state.get("brightness", 3) if self.aura_ctrl else 3
        self.lbl_brightness_val.set_markup(f"<span foreground='#38bdf8' font='11' weight='bold'>Nivel {cur_b}/3</span>")
        b_hdr.pack_end(self.lbl_brightness_val, False, False, 0)
        b_card.pack_start(b_hdr, False, False, 0)

        # Slider de brillo
        self.scale_brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 3, 1)
        self.scale_brightness.set_value(cur_b)
        self.scale_brightness.set_draw_value(False)
        self.scale_brightness.add_mark(0, Gtk.PositionType.BOTTOM, "0 (Apagado)")
        self.scale_brightness.add_mark(1, Gtk.PositionType.BOTTOM, "1 (Bajo)")
        self.scale_brightness.add_mark(2, Gtk.PositionType.BOTTOM, "2 (Medio)")
        self.scale_brightness.add_mark(3, Gtk.PositionType.BOTTOM, "3 (Máximo)")
        self.scale_brightness.connect("value-changed", self.on_brightness_scale_changed)
        b_card.pack_start(self.scale_brightness, False, False, 0)

        box.pack_start(b_card, False, False, 0)

        # 3. Tarjeta de Control por Zonas
        zones_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        zones_card.get_style_context().add_class("card")

        z_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        z_title = Gtk.Label()
        z_title.set_markup("<span foreground='#ffffff' weight='bold' font='12'>⌨️ Personalización por Zonas (Teclado, Barra y Pantalla)</span>")
        z_header.pack_start(z_title, False, False, 0)

        # Switch Sincronizar Todo
        sync_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        sync_lbl = Gtk.Label()
        sync_lbl.set_markup("<span foreground='#9ca3af' font='10'>Sincronizar Todas (Global):</span>")
        self.switch_sync = Gtk.Switch()
        is_sync = self.aura_ctrl.state.get("sync", True) if self.aura_ctrl else True
        self.switch_sync.set_active(is_sync)
        self.switch_sync.connect("state-set", self.on_sync_switched)
        sync_box.pack_start(sync_lbl, False, False, 0)
        sync_box.pack_start(self.switch_sync, False, False, 0)
        z_header.pack_end(sync_box, False, False, 0)

        zones_card.pack_start(z_header, False, False, 0)

        # 3.1 Subsección: Teclado (4 Zonas)
        kb_sub_lbl = Gtk.Label()
        kb_sub_lbl.set_markup("<span foreground='#38bdf8' weight='bold' font='10'>⌨️ TECLADO RGB (4 ZONAS INDEPENDIENTES)</span>")
        kb_sub_lbl.set_halign(Gtk.Align.START)
        zones_card.pack_start(kb_sub_lbl, False, False, 0)

        kb_zones_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        kb_zones_hbox.set_homogeneous(True)

        kb_zone_defs = [
            ("Zona 1 (WASD)", "Izquierda / Letras Q-W-E-R"),
            ("Zona 2 (Centro-Izq)", "Centro / Teclas T-Y-U-I"),
            ("Zona 3 (Centro-Der)", "Centro / Teclas O-P-Enter"),
            ("Zona 4 (NumPad)", "Derecha / Teclado Numérico")
        ]

        saved_zones = self.aura_ctrl.state.get("zones", ["#ff0000"] * 7) if self.aura_ctrl else ["#ff0000"] * 7
        self.zone_buttons = []

        for i, (zn, desc) in enumerate(kb_zone_defs):
            zbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            zbox.get_style_context().add_class("aura-zone-box")

            zl = Gtk.Label()
            zl.set_markup(f"<span foreground='#ffffff' font='11' weight='bold'>{zn}</span>")
            zl.set_halign(Gtk.Align.CENTER)
            zbox.pack_start(zl, False, False, 0)

            zd = Gtk.Label()
            zd.set_markup(f"<span foreground='#6b7280' font='8'>{desc}</span>")
            zd.set_halign(Gtk.Align.CENTER)
            zbox.pack_start(zd, False, False, 0)

            rgba = Gdk.RGBA()
            color_hex = saved_zones[i] if i < len(saved_zones) else "#ff0000"
            rgba.parse(color_hex)
            cbtn = Gtk.ColorButton.new_with_rgba(rgba)
            cbtn.set_title(f"Seleccionar color para {zn}")
            cbtn.connect("color-set", self.on_zone_color_picked, i)
            zbox.pack_start(cbtn, False, False, 4)

            self.zone_buttons.append(cbtn)
            kb_zones_hbox.pack_start(zbox, True, True, 0)

        zones_card.pack_start(kb_zones_hbox, False, False, 0)

        # 3.2 Subsección: Chasis y Pantalla (3 Zonas: Barra Frontal y Logo Trasero)
        periph_sub_lbl = Gtk.Label()
        periph_sub_lbl.set_markup("<span foreground='#38bdf8' weight='bold' font='10'>✨ BARRA FRONTAL Y LOGO TRASERO (PANTALLA)</span>")
        periph_sub_lbl.set_halign(Gtk.Align.START)
        zones_card.pack_start(periph_sub_lbl, False, False, 4)

        periph_zones_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        periph_zones_hbox.set_homogeneous(True)

        periph_zone_defs = [
            ("Zona 5 (Barra Frontal Izq)", "Borde inferior frontal izquierdo"),
            ("Zona 6 (Barra Frontal Der)", "Borde inferior frontal derecho"),
            ("Zona 7 (Logo Trasero Pantalla)", "Logotipo ROG en la tapa de pantalla")
        ]

        for j, (zn, desc) in enumerate(periph_zone_defs):
            actual_idx = 4 + j
            zbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            zbox.get_style_context().add_class("aura-zone-box")

            zl = Gtk.Label()
            zl.set_markup(f"<span foreground='#ffffff' font='11' weight='bold'>{zn}</span>")
            zl.set_halign(Gtk.Align.CENTER)
            zbox.pack_start(zl, False, False, 0)

            zd = Gtk.Label()
            zd.set_markup(f"<span foreground='#6b7280' font='8'>{desc}</span>")
            zd.set_halign(Gtk.Align.CENTER)
            zbox.pack_start(zd, False, False, 0)

            rgba = Gdk.RGBA()
            color_hex = saved_zones[actual_idx] if actual_idx < len(saved_zones) else "#ff0000"
            rgba.parse(color_hex)
            cbtn = Gtk.ColorButton.new_with_rgba(rgba)
            cbtn.set_title(f"Seleccionar color para {zn}")
            cbtn.connect("color-set", self.on_zone_color_picked, actual_idx)
            zbox.pack_start(cbtn, False, False, 4)

            self.zone_buttons.append(cbtn)
            periph_zones_hbox.pack_start(zbox, True, True, 0)

        zones_card.pack_start(periph_zones_hbox, False, False, 0)

        # Nota explicativa
        logo_note = Gtk.Label()
        logo_note.set_markup(
            "<span foreground='#9ca3af' font='10'>"
            "• <b>Control Total Independiente:</b> Puedes seleccionar un color diferente para cada zona apagando el switch de sincronización.\n"
            "• <b>Logo Trasero y Barra:</b> Ahora disponen de control independiente de hardware gracias al direccionamiento de 7 zonas."
            "</span>"
        )
        logo_note.set_halign(Gtk.Align.START)
        zones_card.pack_start(logo_note, False, False, 0)

        box.pack_start(zones_card, False, False, 0)

        # 4. Tarjeta de Presets Rápidos y Modos Dinámicos
        presets_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
