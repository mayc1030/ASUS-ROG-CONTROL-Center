    def create_preset_button(self, label_text, callback):
        btn = Gtk.Button()
        btn.get_style_context().add_class("btn-preset")
        lbl = Gtk.Label()
        lbl.set_markup(f"<span font='10'><b>{label_text}</b></span>")
        btn.add(lbl)
        btn.connect("clicked", lambda b: callback())
        return btn

    def on_stealth_switched(self, switch, state):
        if not self.aura_ctrl:
            return False
        if state:
            self.aura_ctrl.turn_off()
            self.scale_brightness.set_value(0)
            self.lbl_brightness_val.set_markup("<span foreground='#ef4444' font='11' weight='bold'>Nivel 0/3 (Apagado)</span>")
        else:
            self.aura_ctrl.restore_state()
            b = self.aura_ctrl.state.get("brightness", 3)
            self.scale_brightness.set_value(b)
            self.lbl_brightness_val.set_markup(f"<span foreground='#38bdf8' font='11' weight='bold'>Nivel {b}/3</span>")
            self.refresh_zone_buttons_from_state()
        return False

    def on_brightness_scale_changed(self, scale):
        if not self.aura_ctrl:
            return
        val = int(scale.get_value())
        self.aura_ctrl.set_brightness(val)
        if val == 0:
            self.lbl_brightness_val.set_markup("<span foreground='#ef4444' font='11' weight='bold'>Nivel 0/3 (Apagado)</span>")
            self.switch_stealth.handler_block_by_func(self.on_stealth_switched)
            self.switch_stealth.set_active(True)
            self.switch_stealth.handler_unblock_by_func(self.on_stealth_switched)
        else:
            self.lbl_brightness_val.set_markup(f"<span foreground='#38bdf8' font='11' weight='bold'>Nivel {val}/3</span>")
            self.switch_stealth.handler_block_by_func(self.on_stealth_switched)
            self.switch_stealth.set_active(False)
            self.switch_stealth.handler_unblock_by_func(self.on_stealth_switched)

    def on_sync_switched(self, switch, state):
        if not self.aura_ctrl:
            return False
        self.aura_ctrl.state["sync"] = state
        self.aura_ctrl.save_state()
        if state and self.zone_buttons:
            rgba = self.zone_buttons[0].get_rgba()
            r, g, b = int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255)
            hex_c = f"#{r:02x}{g:02x}{b:02x}"
            self.aura_ctrl.set_single_static(hex_c)
            for btn in self.zone_buttons:
                btn.set_rgba(rgba)
        return False

    def on_zone_color_picked(self, color_button, zone_idx):
        if not self.aura_ctrl:
            return
        rgba = color_button.get_rgba()
        r, g, b = int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255)
        hex_c = f"#{r:02x}{g:02x}{b:02x}"

        is_sync = self.switch_sync.get_active()
        if is_sync:
            self.aura_ctrl.set_single_static(hex_c)
            for btn in self.zone_buttons:
                btn.set_rgba(rgba)
        else:
            # zone_idx es 0..6 -> Hardware zone es 1..7
            self.aura_ctrl.set_zone_color(zone_idx + 1, hex_c)

        if self.scale_brightness.get_value() == 0:
            self.scale_brightness.set_value(3)

    def apply_quick_preset(self, preset_name):
        if not self.aura_ctrl:
            return
        if preset_name == "red":
            self.aura_ctrl.set_single_static("#ff0000")
        elif preset_name == "cyberpunk":
            cyberpunk_colors = [
                "#ff0055",  # 1: WASD / Neon Pink
                "#aa00ff",  # 2: Centro-Izq / Electric Purple
                "#00d4ff",  # 3: Centro-Der / Cyan Blue
                "#00ffaa",  # 4: NumPad / Neon Mint
                "#ff0055",  # 5: Barra Frontal Izq
                "#00d4ff",  # 6: Barra Frontal Der
                "#aa00ff"   # 7: Logo Trasero Pantalla
            ]
            self.aura_ctrl.set_multi_static(cyberpunk_colors)
            self.switch_sync.handler_block_by_func(self.on_sync_switched)
            self.switch_sync.set_active(False)
            self.switch_sync.handler_unblock_by_func(self.on_sync_switched)
        elif preset_name == "blue":
            self.aura_ctrl.set_single_static("#0088ff")
        elif preset_name == "green":
            self.aura_ctrl.set_single_static("#00ff00")
        elif preset_name == "white":
            self.aura_ctrl.set_single_static("#ffffff")
        elif preset_name == "cyan":
            self.aura_ctrl.set_single_static("#00ffff")
        elif preset_name == "rainbow":
            self.aura_ctrl.set_mode("rainbow", speed=2)
        elif preset_name == "cycle":
            self.aura_ctrl.set_mode("colorcycle", speed=2)
        elif preset_name == "breathing":
            self.aura_ctrl.set_mode("breathing", speed=2, color1="#ff0000", color2="#000000")
        elif preset_name == "off":
            self.aura_ctrl.turn_off()
            self.scale_brightness.set_value(0)
            self.switch_stealth.set_active(True)
            return

        if self.scale_brightness.get_value() == 0:
            self.scale_brightness.set_value(3)
        self.switch_stealth.set_active(False)
        self.refresh_zone_buttons_from_state()

    def refresh_zone_buttons_from_state(self):
        if not self.aura_ctrl or not hasattr(self, "zone_buttons"):
            return
        zones = self.aura_ctrl.state.get("zones", ["#ff0000"] * 7)
        for i in range(min(len(zones), len(self.zone_buttons))):
            rgba = Gdk.RGBA()
            rgba.parse(zones[i])
            self.zone_buttons[i].set_rgba(rgba)

