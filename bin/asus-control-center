#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ASUS ROG Strix GL504GM Control Center (Dark Gamer Edition + Suite de Servicios)
Permite monitorear, controlar ventiladores, teclado, gráficos y protección de pantalla.
"""

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk, Pango
import subprocess
import os
import re
import glob
import sys

# Importar controlador de iluminación ASUS Aura RGB
try:
    from asus_aura import AuraController
except ImportError:
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    try:
        from asus_aura import AuraController
    except ImportError:
        AuraController = None

ASUS_WMI = "/sys/devices/platform/asus-nb-wmi"
TURBO_FILE = "/sys/devices/system/cpu/intel_pstate/no_turbo"
BOOST_FILE = f"{ASUS_WMI}/fan_boost_mode"
LID_CONF = "/etc/systemd/logind.conf.d/ignore-lid.conf"

class AsusControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="ASUS ROG Strix Control Center")
        self.set_default_size(840, 700)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(14)
        
        # Inicializar controlador de luces Aura
        self.aura_ctrl = None
        if AuraController:
            try:
                self.aura_ctrl = AuraController()
            except Exception as e:
                print(f"Aviso: No se pudo inicializar AuraController: {e}")

        self.apply_dark_theme()

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(main_box)

        # 1. HEADER (Estilo ROG Republic of Gamers)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=15)
        header.get_style_context().add_class("header-bar")

        logo_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label()
        title_lbl.set_markup("<span font='18' weight='heavy' foreground='#ff2a44'>ROG</span> <span font='18' weight='bold' foreground='#ffffff'>STRIX CONTROL</span>")
        title_lbl.set_halign(Gtk.Align.START)
        
        sub_lbl = Gtk.Label()
        sub_lbl.set_markup("<span foreground='#9ca3af' font='10'>ASUS GL504GM • Intel i7-8750H • GTX 1060 • Linux Gaming Hub</span>")
        sub_lbl.set_halign(Gtk.Align.START)
        
        logo_box.pack_start(title_lbl, False, False, 0)
        logo_box.pack_start(sub_lbl, False, False, 0)
        header.pack_start(logo_box, False, False, 0)

        # Badge indicador rápido
        self.badge_status = Gtk.Label()
        self.badge_status.set_markup("<span background='#065f46' foreground='#34d399' weight='bold' font='10'>  ● MODO SILENCIOSO ACTIVO  </span>")
        self.badge_status.set_valign(Gtk.Align.CENTER)
        header.pack_end(self.badge_status, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # 2. NOTEBOOK CON PESTAÑAS
        self.notebook = Gtk.Notebook()
        main_box.pack_start(self.notebook, True, True, 0)

        # Pestañas
        self.notebook.append_page(self.create_fans_tab(), Gtk.Label(label="❄️ Ventiladores y Rendimiento"))
        self.notebook.append_page(self.create_keyboard_tab(), Gtk.Label(label="⌨️ Control de Teclado"))
        self.notebook.append_page(self.create_lighting_tab(), Gtk.Label(label="🌈 Iluminación Aura RGB"))
        self.notebook.append_page(self.create_services_tab(), Gtk.Label(label="⚙️ Servicios e Inicio Automático"))
        self.notebook.append_page(self.create_guide_tab(), Gtk.Label(label="📖 Guía para Otras Distros"))

        # Iniciar actualización periódica de telemetría (cada 2 segundos)
        GLib.timeout_add_seconds(2, self.update_telemetry)
        self.update_telemetry()

