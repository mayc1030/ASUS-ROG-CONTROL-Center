    # PESTAÑA 4: GUÍA PASO A PASO PARA OTRAS DISTROS
    # --------------------------------------------------------------------------
    def create_guide_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(12)

        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        t_lbl = Gtk.Label()
        t_lbl.set_markup("<span foreground='#ffffff' weight='bold' font='12'>Documentación Técnica para Replicar en Arch, Fedora, Debian, Mint</span>")
        btn_copy = Gtk.Button(label="📋 Copiar Guía al Portapapeles")
        btn_copy.connect("clicked", self.copy_guide)
        top_bar.pack_start(t_lbl, False, False, 0)
        top_bar.pack_end(btn_copy, False, False, 0)
        box.pack_start(top_bar, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_shadow_type(Gtk.ShadowType.IN)

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.text_view.set_left_margin(16)
        self.text_view.set_right_margin(16)
        self.text_view.set_top_margin(14)
        self.text_view.set_bottom_margin(14)

        buffer = self.text_view.get_buffer()
        buffer.set_text(self.get_guide_content())

        scrolled.add(self.text_view)
        box.pack_start(scrolled, True, True, 0)
        return box

    # --------------------------------------------------------------------------
    # LÓGICA DE EVENTOS
    # --------------------------------------------------------------------------
    def on_toggle_fan_service(self, switch, state):
        cmd = "enable --now" if state else "disable --now"
        full_cmd = f"sudo -n systemctl {cmd} asus-fan-fix.service 2>/dev/null || pkexec systemctl {cmd} asus-fan-fix.service"
        subprocess.Popen(full_cmd, shell=True)
        GLib.timeout_add(1000, self.update_telemetry)
        return False

    def on_toggle_kbd_service(self, switch, state):
        cmd = "enable --now" if state else "disable --now"
        subprocess.run(f"systemctl --user {cmd} auto-teclado.service", shell=True)
        GLib.timeout_add(1000, self.update_telemetry)
        return False

    def on_toggle_lid_protection(self, switch, state):
        if state:
            cmd = f"echo -e '[Login]\\nHandleLidSwitch=ignore\\nHandleLidSwitchExternalPower=ignore' | sudo -n tee {LID_CONF} >/dev/null 2>&1 || pkexec bash -c 'mkdir -p /etc/systemd/logind.conf.d && echo -e \"[Login]\\nHandleLidSwitch=ignore\\nHandleLidSwitchExternalPower=ignore\" > {LID_CONF}'"
        else:
            cmd = f"sudo -n rm -f {LID_CONF} 2>/dev/null || pkexec rm -f {LID_CONF}"
        subprocess.Popen(cmd, shell=True)
        GLib.timeout_add(1000, self.update_telemetry)
        return False

    def set_prime_mode(self, mode):
        full_cmd = f"sudo -n prime-select {mode} 2>/dev/null || pkexec prime-select {mode}"
        subprocess.Popen(full_cmd, shell=True)
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=f"Modo Gráfico '{mode.upper()}' Aplicado"
        )
        dialog.format_secondary_text("Para que el cambio de controlador surta efecto, debes reiniciar el equipo.")
        dialog.run()
        dialog.destroy()
        self.update_telemetry()

    def on_switch_driver_clicked(self, widget):
        paths = [
            "/usr/local/bin/cambiar-driver-550.sh",
            os.path.expanduser("~/cambiar-driver-550.sh"),
            os.path.expanduser("~/ASUS-ROG-CONTROL-Center/bin/cambiar-driver-550.sh")
        ]
        script_path = None
        for p in paths:
            if os.path.exists(p):
                script_path = p
                break

        if script_path:
            dialog = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.OK_CANCEL,
                text="¿Aplicar Blindaje de Pantalla y Estabilización PCIe/GPU?"
            )
            dialog.format_secondary_text(
                "Este asistente aplicará automáticamente los siguientes ajustes:\n\n"
                "1. Blindar el sensor magnético de la tapa (ignorar falsos cierres de tapa).\n"
                "2. Estabilizar el bus PCIe en GRUB (pcie_aspm=off) para evitar caídas de la GPU.\n"
                "3. Fijar parámetros de energía de NVIDIA (evita caídas de bus en reposo).\n"
                "4. Asegurar el modo On-Demand para que los puertos HDMI/Mini-DP funcionen siempre.\n\n"
                "Se abrirá una terminal para ingresar tu contraseña de administrador y ver el proceso en vivo."
            )
            res = dialog.run()
            dialog.destroy()
            if res == Gtk.ResponseType.OK:
                terminal_cmd = f"mate-terminal --title='Blindaje y Estabilización ASUS ROG' -- bash -c 'sudo bash {script_path}; echo; echo \"===================================================\"; echo \"✔ Proceso finalizado. Presiona ENTER para salir.\"; read -r line' 2>/dev/null || x-terminal-emulator -e 'bash -c \"sudo bash {script_path}; read -p \\\"Presiona ENTER...\\\"\"'"
                subprocess.Popen(terminal_cmd, shell=True)

    def on_reinstall_all_clicked(self, widget):
        script_path = "/home/maycol/instalar-ventiladores.sh"
        if os.path.exists(script_path):
            cmd = f"sudo -n bash {script_path} 2>/dev/null || pkexec bash {script_path}"
            p = subprocess.Popen(cmd, shell=True)
            p.wait()
            
            dialog = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                text="¡Reinstalación Completada!"
            )
            dialog.format_secondary_text("Todos los servicios, configuraciones, permisos y accesos directos han sido restaurados con éxito.")
            dialog.run()
            dialog.destroy()
            self.update_telemetry()

    def update_telemetry(self):
        # 1. CPU Temp
        cpu_t = "N/D"
        try:
            out = subprocess.check_output("sensors", shell=True, text=True, stderr=subprocess.DEVNULL)
            for line in out.splitlines():
                if "Package id 0:" in line:
                    cpu_t = line.split(":")[1].split("(")[0].strip()
                    break
        except: pass
        self.lbl_cpu_temp.set_markup(f"<span foreground='#38bdf8' font='20' weight='heavy'>{cpu_t}</span>")

        # 2. GPU Temp / Modo Intel
        prime_val = "intel"
        try:
            prime_val = subprocess.check_output("prime-select query 2>/dev/null || echo intel", shell=True, text=True).strip()
        except: pass

        if prime_val == "intel":
            self.lbl_gpu_temp.set_markup("<span foreground='#34d399' font='14' weight='bold'>STANDBY (0W)</span>")
        else:
            gpu_t = "N/D"
            try:
                out = subprocess.check_output("nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader", shell=True, text=True, stderr=subprocess.DEVNULL)
                gpu_t = f"+{out.strip()}.0°C"
            except: pass
            self.lbl_gpu_temp.set_markup(f"<span foreground='#34d399' font='20' weight='heavy'>{gpu_t}</span>")

        # 3. Fans
        hw_list = glob.glob(f"{ASUS_WMI}/hwmon/hwmon*")
        f1, f2 = "-- RPM", "-- RPM"
        if hw_list:
            hw = hw_list[0]
            try: f1 = open(f"{hw}/fan1_input").read().strip() + " RPM"
            except: pass
            try: f2 = open(f"{hw}/fan2_input").read().strip() + " RPM"
            except: pass
        self.lbl_fan1_rpm.set_markup(f"<span foreground='#a78bfa' font='20' weight='heavy'>{f1}</span>")
        self.lbl_fan2_rpm.set_markup(f"<span foreground='#f472b6' font='20' weight='heavy'>{f2}</span>")

        # 4. Freq
        try:
            out = subprocess.check_output("awk '{sum+=$1; count++} END {printf \"%.0f MHz\", sum/count/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq", shell=True, text=True)
            self.lbl_cpu_freq.set_markup(f"<span foreground='#38bdf8' weight='bold'>{out.strip()}</span>")
        except: pass

        # 5. Perfil Activo
        active_p = "0"
        if os.path.exists(BOOST_FILE):
            active_p = open(BOOST_FILE).read().strip()

        for b, cls in [(self.btn_silent, "active-silent"), (self.btn_balanced, "active-balanced"), (self.btn_turbo, "active-turbo")]:
            b.get_style_context().remove_class(cls)

        if active_p == "2":
            self.btn_silent.get_style_context().add_class("active-silent")
            self.lbl_current_p.set_markup("<span foreground='#10b981' weight='bold'>● Perfil Activo: SILENCIOSO (2)</span>")
            self.badge_status.set_markup("<span background='#065f46' foreground='#34d399' weight='bold' font='10'>  ● SILENCIOSO (2.2 GHz)  </span>")
        elif active_p == "1":
            self.btn_turbo.get_style_context().add_class("active-turbo")
            self.lbl_current_p.set_markup("<span foreground='#ef4444' weight='bold'>● Perfil Activo: OVERBOOST / TURBO (1)</span>")
            self.badge_status.set_markup("<span background='#7f1d1d' foreground='#fca5a5' weight='bold' font='10'>  ● MODO TURBO MÁXIMO  </span>")
        else:
            self.btn_balanced.get_style_context().add_class("active-balanced")
            self.lbl_current_p.set_markup("<span foreground='#3b82f6' weight='bold'>● Perfil Activo: EQUILIBRADO (0)</span>")
            self.badge_status.set_markup("<span background='#1e3a8a' foreground='#93c5fd' weight='bold' font='10'>  ● EQUILIBRADO (Normal)  </span>")

        # 6. Turbo Switch
        if os.path.exists(TURBO_FILE):
            no_turbo = open(TURBO_FILE).read().strip() == "1"
            self.turbo_switch.handler_block_by_func(self.on_turbo_switched)
            self.turbo_switch.set_active(not no_turbo)
            self.turbo_switch.handler_unblock_by_func(self.on_turbo_switched)

            if no_turbo:
                self.turbo_desc.set_markup("<span foreground='#34d399'><b>DESACTIVADO (Fresco y Silencioso):</b> El procesador se queda en 2.2 GHz sin calentarse.</span>")
            else:
                self.turbo_desc.set_markup("<span foreground='#f59e0b'><b>ACTIVADO (Máxima Potencia):</b> El procesador puede saltar hasta 4.1 GHz cuando juegues.</span>")

        # 7. Teclado
        try:
            out = subprocess.check_output("xinput list", shell=True, text=True)
            is_disabled = True
            for line in out.splitlines():
                if ("Asus Keyboard" in line or "AT Translated" in line) and "FALCHION" not in line and "CHAKRAM" not in line:
                    if "[slave" in line:
                        is_disabled = False
                        break

            self.btn_k_action.get_style_context().remove_class("btn-action-green")
            self.btn_k_action.get_style_context().remove_class("btn-action-red")

            if is_disabled:
                self.lbl_k_state.set_markup("<span foreground='#ef4444' font='14' weight='bold'>🔴 DESACTIVADO (Congelado)</span>\n<span foreground='#9ca3af' font='10'>El teclado del portátil está en silencio para evitar teclas locas.</span>")
                self.btn_k_action.set_label("🟢 Activar Teclado Interno")
                self.btn_k_action.get_style_context().add_class("btn-action-green")
            else:
                self.lbl_k_state.set_markup("<span foreground='#10b981' font='14' weight='bold'>🟢 ACTIVADO (Operativo)</span>\n<span foreground='#9ca3af' font='10'>El teclado del portátil responde a todas las pulsaciones.</span>")
                self.btn_k_action.set_label("🔴 Desactivar Teclado Interno")
                self.btn_k_action.get_style_context().add_class("btn-action-red")

            falchion = "ASUSTeK ROG FALCHION" in out
            if falchion:
                self.lbl_ext_info.set_markup("<span foreground='#34d399' font='11'>🟢 <b>Conectado:</b> ASUS ROG FALCHION detectado y listo.</span>")
            else:
                self.lbl_ext_info.set_markup("<span foreground='#6b7280' font='11'>⚪ Ningún teclado externo conectado actualmente.</span>")

            daemon_active = subprocess.call("systemctl --user is-active auto-teclado.service", shell=True, stdout=subprocess.DEVNULL) == 0
            if daemon_active:
                self.lbl_daemon_info.set_markup("<span foreground='#9ca3af' font='10'>🛡️ <b>Servicio automático:</b> Activo (silencia el teclado del portátil cuando el Falchion está conectado).</span>")
            else:
                self.lbl_daemon_info.set_markup("<span foreground='#ef4444' font='10'>🛡️ Servicio automático detenido.</span>")
        except: pass

        # 8. Servicios (Pestaña 3)
        try:
            # Fan service
            fan_svc_enabled = subprocess.call("systemctl is-enabled asus-fan-fix.service", shell=True, stdout=subprocess.DEVNULL) == 0
            fan_svc_active = subprocess.call("systemctl is-active asus-fan-fix.service", shell=True, stdout=subprocess.DEVNULL) == 0
            
            self.switch_fan_service.handler_block_by_func(self.on_toggle_fan_service)
            self.switch_fan_service.set_active(fan_svc_enabled)
            self.switch_fan_service.handler_unblock_by_func(self.on_toggle_fan_service)

            if fan_svc_enabled and fan_svc_active:
                self.lbl_fan_svc_status.set_markup("<span foreground='#34d399'>● <b>Estado:</b> ACTIVO y HABILITADO al arranque del sistema.</span>")
            elif fan_svc_enabled:
                self.lbl_fan_svc_status.set_markup("<span foreground='#fbbf24'>● <b>Estado:</b> HABILITADO al arranque.</span>")
            else:
                self.lbl_fan_svc_status.set_markup("<span foreground='#9ca3af'>○ <b>Estado:</b> DESHABILITADO del arranque.</span>")

            # Keyboard service
            kbd_svc_enabled = subprocess.call("systemctl --user is-enabled auto-teclado.service", shell=True, stdout=subprocess.DEVNULL) == 0
            kbd_svc_active = subprocess.call("systemctl --user is-active auto-teclado.service", shell=True, stdout=subprocess.DEVNULL) == 0

            self.switch_kbd_service.handler_block_by_func(self.on_toggle_kbd_service)
            self.switch_kbd_service.set_active(kbd_svc_enabled)
            self.switch_kbd_service.handler_unblock_by_func(self.on_toggle_kbd_service)

            if kbd_svc_enabled and kbd_svc_active:
                self.lbl_kbd_svc_status.set_markup("<span foreground='#34d399'>● <b>Estado:</b> ACTIVO y HABILITADO en el inicio de sesión.</span>")
            else:
                self.lbl_kbd_svc_status.set_markup("<span foreground='#9ca3af'>○ <b>Estado:</b> DESHABILITADO.</span>")

            # Lid protection
            lid_protected = os.path.exists(LID_CONF)
            self.switch_lid_protection.handler_block_by_func(self.on_toggle_lid_protection)
            self.switch_lid_protection.set_active(lid_protected)
            self.switch_lid_protection.handler_unblock_by_func(self.on_toggle_lid_protection)

            if lid_protected:
                self.lbl_lid_status.set_markup("<span foreground='#34d399'>● <b>Protección Activa:</b> La pantalla nunca se apagará por falso contacto de la tapa.</span>")
            else:
                self.lbl_lid_status.set_markup("<span foreground='#f59e0b'>○ <b>Protección Inactiva:</b> La pantalla puede apagarse si el sensor magnético detecta cierre.</span>")

            # Driver version and stabilization status
            driver_ver = "N/A"
            try:
                out_ver = subprocess.check_output("cat /proc/driver/nvidia/version 2>/dev/null | head -n 1 | awk '{print $8}'", shell=True, text=True).strip()
                if out_ver: driver_ver = out_ver
            except: pass

            grub_ok = False
            try:
                with open("/proc/cmdline", "r") as f:
                    grub_ok = "pcie_aspm=off" in f.read()
            except: pass

            pwr_ok = os.path.exists("/etc/modprobe.d/nvidia-power-fix.conf")

            if lid_protected and grub_ok and pwr_ok:
                self.lbl_driver_info.set_markup(f"<span foreground='#34d399'>✔ <b>Sistema Blindado:</b> Driver {driver_ver} • Bus PCIe Estable • HDMI Activo.</span>")
                self.btn_install_550.set_label("🛡️ Volver a Ejecutar Blindaje / Estabilización")
            elif lid_protected and pwr_ok:
                self.lbl_driver_info.set_markup(f"<span foreground='#38bdf8'>ℹ️ <b>Reinicio Pendiente:</b> Blindaje configurado. Reinicia para activar kernel PCIe.</span>")
                self.btn_install_550.set_label("🛡️ Blindaje Configurado (Reiniciar para aplicar)")
            else:
                self.lbl_driver_info.set_markup(f"<span foreground='#f59e0b'>⚠️ <b>Estabilización Pendiente:</b> Falta blindar bus PCIe y energía para evitar apagones.</span>")
                self.btn_install_550.set_label("🛡️ Aplicar Blindaje de Pantalla y Estabilización PCIe/GPU")

            mode_color = "#34d399" if prime_val == "intel" else ("#38bdf8" if prime_val == "on-demand" else "#ef4444")
            self.lbl_prime_status.set_markup(f"<span foreground='#ffffff'><b>Modo Actual:</b> <span foreground='{mode_color}' weight='bold'>{prime_val.upper()}</span></span>")
        except: pass

        return True

    def set_profile(self, mode):
        name = "silent" if mode == 2 else ("turbo" if mode == 1 else "balanced")
        cmd = f"sudo -n /usr/local/bin/asus-fan {name} 2>/dev/null || /home/maycol/.local/bin/asus-fan {name}"
        subprocess.Popen(cmd, shell=True)
        GLib.timeout_add(600, self.update_telemetry)

    def on_turbo_switched(self, switch, state):
        arg = "on" if state else "off"
        cmd = f"sudo -n /usr/local/bin/asus-fan turbo-boost {arg} 2>/dev/null || /home/maycol/.local/bin/asus-fan turbo-boost {arg}"
        subprocess.Popen(cmd, shell=True)
        return False

    def on_toggle_keyboard(self, widget):
        subprocess.run("/home/maycol/.local/bin/toggle-teclado-laptop", shell=True)
        self.update_telemetry()

    def copy_guide(self, widget):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(self.get_guide_content(), -1)
        subprocess.run(["notify-send", "-i", "dialog-information", "ASUS Control Center", "Guía técnica copiada al portapapeles."])

    def get_guide_content(self):
        return """================================================================================
GUÍA TÉCNICA MAESTRA: OPTIMIZACIÓN ASUS ROG STRIX GL504GM EN CUALQUIER LINUX
Compatible con: Arch Linux, Fedora, Ubuntu, Debian, Manjaro, Pop!_OS, Linux Mint
================================================================================

1. EL PROBLEMA DE LOS VENTILADORES EN ESTE MODELO
--------------------------------------------------------------------------------
El ASUS ROG Strix GL504GM (Core i7-8750H + GTX 1060 Mobile) sufre de ventiladores
a 5.000+ RPM de golpe debido a 3 causas:
  1) El procesador i7-8750H tiene picos de Turbo Boost a 4.1 GHz que alcanzan
     100°C en milisegundos durante tareas cotidianas (Thermal Throttling).
  2) Al usar modo 'prime-select intel', el driver NVIDIA no comunica la temperatura
     de la GPU a la BIOS/EC; como medida de seguridad, la placa base fuerza el
     ventilador 2 (GPU) al 100% de potencia constante (pwm2_enable = 0).
  3) El disipador de cobre es compartido entre CPU y GPU: el calor se transmite.

2. CÓMO CONTROLAR LOS VENTILADORES EN CUALQUIER DISTRO
--------------------------------------------------------------------------------
El kernel de Linux incluye el módulo 'asus-nb-wmi', que controla la ventilación:
Ruta: /sys/devices/platform/asus-nb-wmi/fan_boost_mode

Valores admitidos:
  • 0 = Normal / Equilibrado (Curva estándar)
  • 1 = Overboost / Turbo (Máxima disipación para juegos exigentes)
  • 2 = Silencioso / Silent (Suaviza la curva térmica y reduce drásticamente el ruido)

Comando directo:
  echo 2 | sudo tee /sys/devices/platform/asus-nb-wmi/fan_boost_mode

3. SERVICIO SYSTEMD DE ARRANQUE AUTOMÁTICO
--------------------------------------------------------------------------------
Para que el modo silencioso arranque siempre al encender el PC en cualquier distro:

Crear archivo: /etc/systemd/system/asus-fan-fix.service
----------------------------------------------------
[Unit]
Description=Control Silencioso de Ventiladores ASUS ROG
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 2 > /sys/devices/platform/asus-nb-wmi/fan_boost_mode'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
----------------------------------------------------

Habilitarlo:
  sudo systemctl daemon-reload
  sudo systemctl enable --now asus-fan-fix.service

4. DOMAR LOS PICOS DE CALOR DEL PROCESADOR (INTEL TURBO BOOST)
--------------------------------------------------------------------------------
El i7-8750H vuela a 2.2 GHz de base. Para trabajar fresco a 45°C sin ruido:
  echo 1 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo

Para volver a activar toda la potencia a 4.1 GHz cuando vayas a jugar:
  echo 0 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo

5. CONFIGURACIÓN CORRECTA DE LA GRÁFICA Y PUERTOS DE PANTALLA (HDMI / MINI-DP)
--------------------------------------------------------------------------------
En el ASUS GL504GM, las salidas físicas HDMI 2.0 y Mini-DisplayPort están cableadas
directamente a los pines de la NVIDIA GTX 1060.
  • MODO RECOMENDADO: 'prime-select on-demand'
    Permite que el sistema use la Intel UHD 630 para el escritorio mientras mantiene
    los puertos externos HDMI y Mini-DP 100% disponibles.
    Comando: sudo prime-select on-demand

  • ADVERTENCIA SOBRE 'prime-select intel':
    Si activas modo 'intel', la GPU dedicada se apaga por completo y NINGUNA pantalla
    externa conectada por HDMI funcionará. Además, la placa base puede forzar el
    ventilador 2 al 100% por falta de lectura térmica de GPU.

6. BLINDAJE CONTRA PANTALLAS NEGRAS Y ESTABILIZACIÓN PCIe
--------------------------------------------------------------------------------
Si la pantalla se apaga sola de forma intermitente o la GPU se desconecta del bus:
  1) Sensor de tapa falso (ignorar pulsos magnéticos involuntarios):
     echo -e "[Login]\\nHandleLidSwitch=ignore\\nHandleLidSwitchExternalPower=ignore" | sudo tee /etc/systemd/logind.conf.d/ignore-lid.conf

  2) Estabilización de bus PCIe en GRUB (evita Xid 79: GPU fallen off the bus):
     Añadir 'pcie_aspm=off pci=noaer i915.enable_psr=0' a GRUB_CMDLINE_LINUX_DEFAULT
     en /etc/default/grub y ejecutar: sudo update-grub

  3) Evitar desconexión por reposo profundo D3cold de NVIDIA:
     Crear /etc/modprobe.d/nvidia-power-fix.conf con:
     options nvidia NVreg_DynamicPowerManagement=0
     options nvidia NVreg_PreserveVideoMemoryAllocations=1

7. TECLADO INTERNO DAÑADO (CRUCE DE MATRIZ Y CÓMO APAGARLO)
--------------------------------------------------------------------------------
En este portátil, el teclado integrado Aura Sync se comunica por un puerto USB
interno ('ASUS N-KEY Device', ID 0b05:1866), NO por PS/2 tradicional.

Para apagar el teclado del portátil cuando uses tu ASUS ROG Falchion:
  xinput list | grep "Asus Keyboard" | grep -o 'id=[0-9]*' | cut -d= -f2 | while read id; do xinput disable $id; done
  xinput disable "AT Translated Set 2 keyboard" 2>/dev/null || true

Para volver a encenderlo:
  xinput list | grep "Asus Keyboard" | grep -o 'id=[0-9]*' | cut -d= -f2 | while read id; do xinput enable $id; done
  xinput enable "AT Translated Set 2 keyboard" 2>/dev/null || true

8. MANTENIMIENTO FÍSICO
--------------------------------------------------------------------------------
• Modelo exacto de batería de repuesto: C41N1727 (15.4V / 66Wh).
• Pasta térmica recomendada para portátiles gamer con contacto directo de silicio:
  Honeywell PTM7950 (fase de cambio) o pastas densas como Noctua NT-H2 o Arctic MX-4.
================================================================================
"""

if __name__ == "__main__":
    app = AsusControlCenter()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()
