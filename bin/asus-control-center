        p_ice = self.create_preset_button("❄️ Ice Blue", lambda: self.apply_quick_preset("blue"))
        p_green = self.create_preset_button("🟢 Matrix Green", lambda: self.apply_quick_preset("green"))
        p_white = self.create_preset_button("⚪ Blanco Puro", lambda: self.apply_quick_preset("white"))

        row1.pack_start(p_red, True, True, 0)
        row1.pack_start(p_cyber, True, True, 0)
        row1.pack_start(p_ice, True, True, 0)
        row1.pack_start(p_green, True, True, 0)
        row1.pack_start(p_white, True, True, 0)
        presets_card.pack_start(row1, False, False, 0)

        # Fila 2 de Presets
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row2.set_homogeneous(True)

